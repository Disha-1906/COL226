split([],[],[]).
split([A],[A],[]).
split([A,B|R],[A|Ra],[B|Rb]) :- split(R,Ra,Rb).


mergesort([],[]). /* covers special case */
mergesort([A],[A]).
mergesort([A,B|R],S) :- split([A,B|R],L1,L2), mergesort(L1,S1),mergesort(L2,S2),merge(S1,S2,S).


has_triplicates([X,X,X|_]).
has_triplicates([_|T]) :- has_triplicates(T).

has_no_triplicates(L) :- mergesort(L,X) ,not(has_triplicates(X)).
